      if (esSalida) {
        badgeMovimiento = '<span style="background:#fee2e2; color:#b91c1c; font-size:10px; font-weight:700; padding:2px 8px; border-radius:10px;"><i class="fa-solid fa-arrow-up-from-bracket"></i> SALIDA</span>';
        const esAveria = r.tipoDestino === 'Avería';
