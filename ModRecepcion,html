  /**
   * Abre el modal de detalle (tipo WH-IN/WH-OUT): pide al backend el cruce
   * completo Requisicion -> Orden de Compra -> Recepcion para ESE recibo
   * especifico, y lo pinta.
   */
  window.recep_VerRecibo = function(idRecepcion) {
    if (typeof google === 'undefined' || !google.script || !google.script.run) return;
    google.script.run
      .withSuccessHandler(function(res) {
        if (!res.exito) { window.erpToast(res.mensaje, 'error'); return; }
        reciboActualParaPdf = res;
        pintarModalRecibo(res);
        document.getElementById('recep-modal-recibo').showModal();
      })
      .withFailureHandler(function(err) { window.erpToast("Error: " + err.message, "error"); })
      .obtenerDetalleRecepcionServidor(idRecepcion);
  };

  function pintarModalRecibo(res) {
    const recepcion = res.recepcion;
    const orden = res.orden;
    const requisiciones = res.requisiciones || [];
    const esSalida = recepcion.tipoMovimiento === 'Salida';
    const esEntregaDirecta = !esSalida && recepcion.tipoDestino === 'Entrega Directa';

    document.getElementById('recibo-id-texto').innerText = recepcion.id;

    // Cadena de trazabilidad visual: Requisicion(es) -> Orden -> Recibo
    // (las salidas no tienen requisicion ni orden de origen, solo su propio id)
    const cadena = document.getElementById('recibo-cadena-trazabilidad');
    const partes = [];
    if (requisiciones.length > 0) partes.push(requisiciones.map(r => r.id).join(', '));
    if (orden) partes.push(orden.id);
    partes.push(recepcion.id);
    cadena.innerHTML = partes.map((p, idx) => {
      const esUltimo = idx === partes.length - 1;
      return '<span style="background:' + (esUltimo ? '#eff6ff' : '#f1f5f9') + '; color:' + (esUltimo ? '#1e40af' : '#475569') + '; font-weight:700; padding:3px 10px; border-radius:10px;">' + p + '</span>' + (idx < partes.length - 1 ? ' <i class="fa-solid fa-arrow-right" style="color:#cbd5e1;"></i> ' : '');
    }).join('');

    const infoReq = document.getElementById('recibo-info-requisicion');
    if (esSalida) {
      infoReq.innerHTML = '<span style="color:#94a3b8;">No aplica para salidas de bodega.</span>';
    } else if (requisiciones.length > 0) {
      infoReq.innerHTML = requisiciones.map(r => '<div style="margin-bottom:4px;"><strong>' + r.id + '</strong> — ' + (r.departamento || 'Sin departamento') + ' · ' + (r.fecha ? new Date(r.fecha).toLocaleDateString() : '') + '</div>').join('');
    } else {
      infoReq.innerHTML = '<span style="color:#94a3b8;">Compra directa, sin requisición de origen.</span>';
    }

    const infoOrden = document.getElementById('recibo-info-orden');
    if (esSalida) {
      const esAveria = recepcion.tipoDestino === 'Avería';
      const esVenta = recepcion.entregaDirectaA && (recepcion.entregaDirectaA.startsWith('Venta') || recepcion.entregaDirectaA.startsWith('VD-'));
      if (esAveria) {
        infoOrden.innerHTML = '<strong>Avería / Ajuste</strong><br>Bodega: ' + (recepcion.bodega || '—');
      } else if (esVenta) {
        infoOrden.innerHTML = '<strong>Salida por Venta</strong><br>Referencia: <span style="color:var(--accent);">' + (recepcion.idOrden || recepcion.entregaDirectaA || '—') + '</span>' +
          (recepcion.bodega && recepcion.bodega !== 'Sin Bodega' ? '<br>Bodega: ' + recepcion.bodega : '');
      } else {
        infoOrden.innerHTML = '<strong>Entrega a Producción</strong><br>Área: ' + (recepcion.entregaDirectaA || '—');
      }
    } else if (orden) {
      infoOrden.innerHTML =
        '<strong>' + orden.id + '</strong><br>' +
        'Proveedor: ' + orden.proveedor + '<br>' +
        'Total: $' + (orden.totalAPagar || 0).toFixed(2);
    } else {
      infoOrden.innerHTML = '<span style="color:#94a3b8;">No disponible.</span>';
    }

    const infoRecepcion = document.getElementById('recibo-info-recepcion');
    let lineaDestino;
    if (esSalida) {
      const esAveria = recepcion.tipoDestino === 'Avería';
      lineaDestino = esAveria
        ? ('Tipo: Avería / Ajuste<br>Bodega de origen: ' + (recepcion.bodega || '—') + (recepcion.recibidoPor ? ('<br>Responsable: ' + recepcion.recibidoPor) : ''))
        : ('Tipo: Entrega a Producción<br>Bodega de origen: ' + (recepcion.bodega || '—') + '<br>Área que recibió: ' + (recepcion.entregaDirectaA || '—') + (recepcion.firmaDigital ? ' <i class="fa-solid fa-circle-check" style="color:#16a34a;" title="Firma confirmada"></i>' : ''));
    } else {
      lineaDestino = esEntregaDirecta
        ? ('Destino: Entrega Directa<br>Recibió: ' + (recepcion.recibidoPor || '—') + (recepcion.firmaDigital ? ' <i class="fa-solid fa-circle-check" style="color:#16a34a;" title="Firma confirmada"></i>' : ''))
        : ('Destino: Bodega' + (recepcion.bodega ? (' — ' + recepcion.bodega) : ''));
    }
    infoRecepcion.innerHTML =
      'Fecha: ' + (recepcion.fecha ? new Date(recepcion.fecha).toLocaleString() : '') + '<br>' +
      'Registrado por: ' + (recepcion.usuario || '—') + '<br>' +
      lineaDestino;

    const listaItems = document.getElementById('recibo-lista-items');
    listaItems.innerHTML = '';
    (recepcion.items || []).forEach(it => {
      const fila = document.createElement('div');
      fila.style.cssText = "background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:10px 12px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;";
      fila.innerHTML =
        '<div><span style="font-size:12px; font-weight:600; color:#1e293b;">' + it.descripcion + '</span>' +
        (it.idRequisicionOrigen ? ('<br><span style="font-size:10px; color:#1e40af;"><i class="fa-solid fa-arrow-turn-up fa-rotate-90" style="font-size:9px;"></i> Desde ' + it.idRequisicionOrigen + '</span>') : '') + '</div>' +
        '<div style="font-size:12px; color:#475569;">Cant: <strong>' + it.cantidadRecibida + '</strong>' + (esSalida ? '' : (' · Costo: $' + parseFloat(it.costoUnitario || 0).toFixed(2))) + '</div>';
      listaItems.appendChild(fila);
    });
  }

  window.recep_DescargarReciboPdf = function() {
    if (!reciboActualParaPdf) return;

    // Primero obtiene los datos de empresa (logo + nombre + nombre ERP) para
    // el encabezado corporativo del PDF, luego genera el documento.
    if (typeof google !== 'undefined' && google.script && google.script.run) {
      google.script.run
        .withSuccessHandler(function(empresa) { generarPdfConEmpresa(empresa || {}); })
        .withFailureHandler(function() { generarPdfConEmpresa({}); })
        .obtenerConfiguracionEmpresaServidor();
    } else {
      generarPdfConEmpresa({});
    }
  };

  function generarPdfConEmpresa(empresa) {
    try {
      const recepcion = reciboActualParaPdf.recepcion;
      const orden = reciboActualParaPdf.orden;
      const requisiciones = reciboActualParaPdf.requisiciones || [];
      const esSalida = recepcion.tipoMovimiento === 'Salida';
      const esEntregaDirecta = !esSalida && recepcion.tipoDestino === 'Entrega Directa';

      const { jsPDF } = window.jspdf;
      const doc = new jsPDF();
      const W = doc.internal.pageSize.getWidth();
      const H = doc.internal.pageSize.getHeight();

      // ── ENCABEZADO CORPORATIVO ──────────────────────────────────────────
      const logoBase64 = empresa.logoUrl || '';
      const nombreEmpresa = empresa.nombreEmpresa || '';
      const nombreErp = empresa.nombreErp || 'ERP Corporativo';

      // Franja de color superior
      const colorFranja = esSalida ? [239, 68, 68] : [37, 99, 235];
      doc.setFillColor(...colorFranja);
      doc.rect(0, 0, W, 28, 'F');

      // Logo a la izquierda (si existe y es base64)
      let xTextoEmpresa = 14;
      if (logoBase64 && logoBase64.startsWith('data:image')) {
        try {
          const formato = logoBase64.includes('data:image/png') ? 'PNG' : 'JPEG';
          doc.addImage(logoBase64, formato, 8, 4, 20, 20);
          xTextoEmpresa = 32;
        } catch(eImg) { /* si el logo falla, continua sin el */ }
      }

      // Nombre de empresa en blanco sobre la franja
      doc.setFontSize(13);
      doc.setFont(undefined, 'bold');
      doc.setTextColor(255, 255, 255);
      doc.text(nombreEmpresa || nombreErp, xTextoEmpresa, 13);

      // Tipo de recibo (WH-IN / WH-OUT) alineado a la derecha
      doc.setFontSize(9);
      doc.setFont(undefined, 'normal');
      doc.text(esSalida ? 'RECIBO DE SALIDA' : 'RECIBO DE RECEPCIÓN', W - 14, 10, { align: 'right' });
      doc.setFontSize(11);
      doc.setFont(undefined, 'bold');
      doc.text(recepcion.id, W - 14, 18, { align: 'right' });

      // ── CUERPO ──────────────────────────────────────────────────────────
      doc.setTextColor(30, 41, 59); // color texto normal (#1e293b)
      let y = 36;

      // Fecha y registrado por
      doc.setFontSize(9);
      doc.setFont(undefined, 'normal');
      doc.text('Fecha: ' + (recepcion.fecha ? new Date(recepcion.fecha).toLocaleString() : '—'), 14, y);
      doc.text('Registrado por: ' + (recepcion.usuario || '—'), W - 14, y, { align: 'right' });
      y += 7;

      // Linea separadora
      doc.setDrawColor(226, 232, 240);
      doc.line(14, y, W - 14, y);
      y += 7;

      // ── CADENA DE TRAZABILIDAD (solo entradas) ──────────────────────────
      if (!esSalida) {
        const partesTrazabilidad = [
          requisiciones.length > 0 ? requisiciones.map(r => r.id).join(', ') : null,
          orden ? orden.id : null,
          recepcion.id
        ].filter(Boolean);

        if (partesTrazabilidad.length > 1) {
          doc.setFontSize(8);
          doc.setFont(undefined, 'bold');
          doc.setTextColor(100, 116, 139);
          doc.text('TRAZABILIDAD', 14, y);
          y += 5;
          doc.setFont(undefined, 'normal');
          doc.setTextColor(30, 41, 59);
          doc.text(partesTrazabilidad.join('  >>  '), 14, y);
          y += 8;
        }
      }

      // ── DOS COLUMNAS: Requisicion / Orden de Compra (o Tipo de Salida) ──
      const xCol2 = W / 2 + 2;
      const yInicioColumnas = y;

      // Columna izquierda: Requisicion de origen (o "No aplica" si es salida)
      doc.setFontSize(8);
      doc.setFont(undefined, 'bold');
      doc.setTextColor(100, 116, 139);
      doc.text(esSalida ? 'TIPO DE SALIDA' : 'REQUISICIÓN DE ORIGEN', 14, y);
      y += 5;
      doc.setFont(undefined, 'normal');
      doc.setTextColor(30, 41, 59);
      if (esSalida) {
        const esAveria = recepcion.tipoDestino === 'Avería';
        doc.text(esAveria ? 'Avería / Ajuste' : 'Entrega a Producción', 14, y);
        y += 4;
        doc.setFontSize(8);
        doc.setTextColor(100, 116, 139);
        doc.text('Bodega: ' + (recepcion.bodega || '—'), 14, y);
        y += 4;
        if (!esAveria) doc.text('Área: ' + (recepcion.entregaDirectaA || '—'), 14, y);
        else if (recepcion.recibidoPor) doc.text('Responsable: ' + recepcion.recibidoPor, 14, y);
      } else if (requisiciones.length > 0) {
        requisiciones.forEach((r, idx) => {
          doc.setFontSize(9);
          doc.setTextColor(30, 41, 59);
          doc.text(r.id, 14, y);
          y += 4;
          doc.setFontSize(8);
          doc.setTextColor(100, 116, 139);
          doc.text((r.departamento || 'Sin departamento'), 14, y);
          if (idx < requisiciones.length - 1) y += 4;
        });
      } else {
        doc.setTextColor(148, 163, 184);
        doc.text('Compra directa', 14, y);
      }

      // Columna derecha: Orden de Compra (o detalles de la recepcion si es salida)
      let yCol2 = yInicioColumnas;
      doc.setFontSize(8);
      doc.setFont(undefined, 'bold');
      doc.setTextColor(100, 116, 139);
      doc.text(esSalida ? 'DETALLES DE RECEPCIÓN' : 'ORDEN DE COMPRA', xCol2, yCol2);
      yCol2 += 5;
      doc.setFont(undefined, 'normal');
      doc.setTextColor(30, 41, 59);
      if (!esSalida && orden) {
        doc.setFontSize(9);
        doc.text(orden.id, xCol2, yCol2);
        yCol2 += 4;
        doc.setFontSize(8);
        doc.setTextColor(100, 116, 139);
        doc.text('Proveedor: ' + orden.proveedor, xCol2, yCol2);
        yCol2 += 4;
        doc.text('Total: $' + parseFloat(orden.totalAPagar || 0).toFixed(2), xCol2, yCol2);
      } else if (!esSalida) {
        doc.setTextColor(148, 163, 184);
        doc.text('No disponible', xCol2, yCol2);
      } else {
        doc.setFontSize(9);
        const esEntregaDirectaRecibo = recepcion.tipoDestino === 'Entrega Directa';
        doc.text(esEntregaDirecta ? 'ENTREGA DIRECTA' : (recepcion.bodega || '—'), xCol2, yCol2);
        if (esEntregaDirecta && recepcion.recibidoPor) {
          yCol2 += 4;
          doc.setFontSize(8);
          doc.setTextColor(100, 116, 139);
          doc.text('Recibió: ' + recepcion.recibidoPor, xCol2, yCol2);
        }
      }

      y = Math.max(y, yCol2) + 8;

      // Linea separadora
      doc.setDrawColor(226, 232, 240);
      doc.line(14, y, W - 14, y);
      y += 4;

      // ── TABLA DE ITEMS ──────────────────────────────────────────────────
      const colorHead = esSalida ? [239, 68, 68] : [37, 99, 235];
      const filasTabla = esSalida
        ? (recepcion.items || []).map(it => [it.descripcion, it.cantidadRecibida])
        : (recepcion.items || []).map(it => [it.descripcion, it.cantidadRecibida, '$' + parseFloat(it.costoUnitario || 0).toFixed(2)]);

      doc.autoTable({
        startY: y,
        head: esSalida
          ? [['Descripción / SKU', 'Cantidad']]
          : [['Descripción / SKU', 'Cantidad Recibida', 'Costo Unit.']],
        body: filasTabla,
        styles: { fontSize: 9, cellPadding: 4 },
        headStyles: { fillColor: colorHead, textColor: 255, fontStyle: 'bold' },
        alternateRowStyles: { fillColor: [248, 250, 252] },
        columnStyles: esSalida
          ? { 1: { halign: 'center', cellWidth: 40 } }
          : { 1: { halign: 'center', cellWidth: 45 }, 2: { halign: 'right', cellWidth: 35 } },
        margin: { left: 14, right: 14 }
      });

      // ── PIE DE PAGINA ───────────────────────────────────────────────────
      const yFinal = H - 10;
      doc.setFontSize(7);
      doc.setFont(undefined, 'normal');
      doc.setTextColor(148, 163, 184);
      doc.text('Powered by ' + nombreErp, W / 2, yFinal, { align: 'center' });

      doc.save(recepcion.id + '.pdf');
    } catch (e) {
      window.erpToast('Error al generar el PDF: ' + e.message, 'error');
    }
  }

  // ==========================================================================
  // REGISTRAR SALIDA — Averia / Entrega a Produccion
  // ==========================================================================
  function poblarSelectorVariantesSalida() {
    const select = document.getElementById('recep-salida-sku');
    if (!select) return;
    const valorActual = select.value;
    select.innerHTML = '<option value="">-- Selecciona una variante --</option>';
    TODAS_LAS_VARIANTES_RECEP.forEach(v => {
      const opt = document.createElement('option');
      opt.value = v.sku;
      opt.innerText = v.descripcion + ' (SKU: ' + v.sku + ')';
      select.appendChild(opt);
    });
    if (valorActual) select.value = valorActual;
  }

  function poblarSelectorBodegasSalida() {
    const select = document.getElementById('recep-salida-bodega');
    if (!select) return;
    const valorActual = select.value;
    select.innerHTML = '<option value="Sin Bodega">Sin Bodega</option>';
    BODEGAS_GLOBAL_RECEP.forEach(b => {
      const opt = document.createElement('option');
      opt.value = b;
      opt.innerText = b;
      select.appendChild(opt);
    });
    if (valorActual) select.value = valorActual;
  }

  window.recep_AbrirModalSalida = function() {
    window.recep_CambiarTipoSalida('Avería');
    document.getElementById('recep-salida-sku').value = '';
    document.getElementById('recep-salida-cantidad').value = '';
    document.getElementById('recep-salida-motivo').value = '';
    document.getElementById('recep-salida-responsable').value = '';
    document.getElementById('recep-salida-area').value = '';
    document.getElementById('recep-salida-nota').value = '';
    document.getElementById('recep-salida-stock-disponible').innerText = '';
    document.getElementById('recep-salida-firma-confirmada-texto').style.display = 'none';
    firmaSalidaCapturada = false;
    document.getElementById('recep-modal-salida').showModal();
  };

  window.recep_CambiarTipoSalida = function(tipo) {
    tipoSalidaActual = tipo;
    const tabAveria = document.getElementById('recep-salida-tab-averia');
    const tabProduccion = document.getElementById('recep-salida-tab-produccion');
    const bloqueAveria = document.getElementById('recep-salida-bloque-averia');
    const bloqueProduccion = document.getElementById('recep-salida-bloque-produccion');

    const esAveria = tipo === 'Avería';
    tabAveria.style.background = esAveria ? '#ef4444' : '#ffffff';
    tabAveria.style.color = esAveria ? 'white' : '#475569';
    tabAveria.style.border = esAveria ? '2px solid #ef4444' : '2px solid #cbd5e1';
    tabProduccion.style.background = !esAveria ? '#ef4444' : '#ffffff';
    tabProduccion.style.color = !esAveria ? 'white' : '#475569';
    tabProduccion.style.border = !esAveria ? '2px solid #ef4444' : '2px solid #cbd5e1';
    bloqueAveria.style.display = esAveria ? 'flex' : 'none';
    bloqueProduccion.style.display = !esAveria ? 'flex' : 'none';
  };

  window.recep_SimularFirmaSalidaPro = function() {
    if (!recepLicenciaPro) {
      window.erpToast("La firma digital de entrega es una función PRO.", "info");
      return;
    }
    firmaSalidaCapturada = true;
    const texto = document.getElementById('recep-salida-firma-confirmada-texto');
    if (texto) texto.style.display = 'inline-block';
    window.erpToast("Firma de entrega confirmada (simulada). La captura real llegará en la app móvil.", "exito");
  };

  window.recep_GuardarSalida = function() {
    const sku = document.getElementById('recep-salida-sku').value;
    const bodega = document.getElementById('recep-salida-bodega').value;
    const cantidad = parseFloat(document.getElementById('recep-salida-cantidad').value) || 0;

    if (!sku) { window.erpToast("Selecciona una variante.", "error"); return; }
    if (cantidad <= 0) { window.erpToast("Ingresa una cantidad mayor a cero.", "error"); return; }

    const datos = {
      sku: sku, bodega: bodega, cantidad: cantidad, tipoSalida: tipoSalidaActual,
      firmaDigital: firmaSalidaCapturada ? 'CONFIRMADA' : ''
    };

    if (tipoSalidaActual === 'Avería') {
      datos.motivo = document.getElementById('recep-salida-motivo').value.trim();
      datos.responsable = document.getElementById('recep-salida-responsable').value.trim();
      if (!datos.motivo) { window.erpToast("Indica el motivo de la avería.", "error"); return; }
    } else {
      datos.areaDestino = document.getElementById('recep-salida-area').value.trim();
      datos.motivo = document.getElementById('recep-salida-nota').value.trim();
      if (!datos.areaDestino) { window.erpToast("Indica el área que recibe.", "error"); return; }
    }

    if (typeof google === 'undefined' || !google.script || !google.script.run) return;
    google.script.run
      .withSuccessHandler(function(res) {
        window.erpToast(res.mensaje, res.exito ? 'exito' : 'error');
        if (res.exito) {
          document.getElementById('recep-modal-salida').close();
          window.recep_CargarDatos();
          if (document.getElementById('recep-panel-recibos').style.display !== 'none') window.recep_CargarHistorial();
        }
      })
      .withFailureHandler(function(err) { window.erpToast("Error: " + err.message, "error"); })
      .registrarSalidaAveriaServidor(datos);
  };

  window.addEventListener('storage', (e) => {
    if (e.key === 'erp_licencia_pro') sincronizarLicenciaLocal();
  });
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) sincronizarLicenciaLocal();
  });
  document.addEventListener('mousemove', () => {
    const checkActual = localStorage.getItem('erp_licencia_pro') === 'true';
    if (checkActual !== recepLicenciaPro) sincronizarLicenciaLocal();
  });

})();
</script>
