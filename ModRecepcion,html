        badgeDestino = esAveria
          ? '<span style="background:#fef3c7; color:#b45309; font-size:10px; font-weight:700; padding:2px 8px; border-radius:10px;">AVERÍA</span>'
          : esVenta
            ? '<span style="background:#f0fdf4; color:#16a34a; font-size:10px; font-weight:700; padding:2px 8px; border-radius:10px;"><i class="fa-solid fa-cash-register"></i> VENTA</span>'
            : '<span style="background:#eff6ff; color:#1e40af; font-size:10px; font-weight:700; padding:2px 8px; border-radius:10px;">ENTREGA A PRODUCCIÓN</span>';
        subtitulo = (r.bodega && r.bodega !== 'Sin Bodega' ? ('Bodega: ' + r.bodega) : '') +
          (r.idOrden ? ' · Ref: ' + r.idOrden : '') +
          (r.entregaDirectaA && !esVenta ? ' · Área: ' + r.entregaDirectaA : '');
      } else {
        badgeMovimiento = '<span style="background:#dcfce7; color:#16a34a; font-size:10px; font-weight:700; padding:2px 8px; border-radius:10px;"><i class="fa-solid fa-truck-ramp-box"></i> ENTRADA</span>';
        const esEntregaDirecta = r.tipoDestino === 'Entrega Directa';
        badgeDestino = esEntregaDirecta
          ? '<span style="background:#eff6ff; color:#1e40af; font-size:10px; font-weight:700; padding:2px 8px; border-radius:10px;">ENTREGA DIRECTA</span>'
          : '<span style="background:#f0fdf4; color:#16a34a; font-size:10px; font-weight:700; padding:2px 8px; border-radius:10px;">BODEGA' + (r.bodega ? (': ' + r.bodega) : '') + '</span>';
        subtitulo = esEntregaDirecta ? ('Recibió: ' + (r.recibidoPor || '—')) : ('Orden: ' + r.idOrden);
      }

      const totalItems = (r.items || []).reduce((acc, it) => acc + (parseFloat(it.cantidadRecibida) || 0), 0);

      const tarjeta = document.createElement('div');
      tarjeta.style.cssText = "border:1px solid #e2e8f0; border-radius:8px; background:white; padding:14px 18px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;";
