<script>
(function() {
  console.log("Core-Recepcion: script inicializado correctamente.");

  let ORDENES_RECEPCION = [];
  let TODAS_LAS_VARIANTES_RECEP = [];
  let BODEGAS_GLOBAL_RECEP = [];
  let tipoSalidaActual = 'Avería';
  let firmaSalidaCapturada = false;
  let RECEPCIONES_HISTORIAL = [];
  let recepLicenciaPro = false;
  let firmaDigitalCapturada = false;
  let reciboActualParaPdf = null;

  setTimeout(() => {
    inicializarEventosRecepcion();
    sincronizarLicenciaLocal();
    window.recep_CambiarTab('pendientes');
    window.recep_CargarDatos();
  }, 50);

  function inicializarEventosRecepcion() {
    const btn = document.getElementById('recep-btn-guardar');
    if (btn) btn.addEventListener('click', () => window.recep_Guardar());

    const btnFirma = document.getElementById('recep-btn-firma-pro');
    if (btnFirma) btnFirma.addEventListener('click', () => window.recep_SimularFirmaPro());

    const btnDescargarRecibo = document.getElementById('recibo-btn-descargar-pdf');
    if (btnDescargarRecibo) btnDescargarRecibo.addEventListener('click', () => window.recep_DescargarReciboPdf());

    const btnGuardarSalida = document.getElementById('recep-btn-guardar-salida');
    if (btnGuardarSalida) btnGuardarSalida.addEventListener('click', () => window.recep_GuardarSalida());

    const btnFirmaSalida = document.getElementById('recep-salida-btn-firma-pro');
    if (btnFirmaSalida) btnFirmaSalida.addEventListener('click', () => window.recep_SimularFirmaSalidaPro());

    const selectSalidaSku = document.getElementById('recep-salida-sku');
    if (selectSalidaSku) selectSalidaSku.addEventListener('change', () => {
      const variante = TODAS_LAS_VARIANTES_RECEP.find(v => v.sku === selectSalidaSku.value);
      const span = document.getElementById('recep-salida-stock-disponible');
      if (span) span.innerText = '';
    });
  }

  window.recep_CambiarTab = function(tab) {
    const tabs = { pendientes: 'recep-tab-pendientes', recibos: 'recep-tab-recibos' };
    const paneles = { pendientes: 'recep-panel-pendientes', recibos: 'recep-panel-recibos' };

    Object.keys(tabs).forEach(key => {
      const btn = document.getElementById(tabs[key]);
      const activo = key === tab;
      btn.style.background = activo ? 'var(--accent)' : '#e2e8f0';
      btn.style.color = activo ? 'white' : 'var(--text)';
      btn.style.fontWeight = activo ? '600' : '500';
      document.getElementById(paneles[key]).style.display = activo ? 'block' : 'none';
    });

    if (tab === 'recibos') window.recep_CargarHistorial();
  };

  function sincronizarLicenciaLocal() {
    const estadoFresco = localStorage.getItem('erp_licencia_pro') === 'true';
    window.actualizarModuloRecepcionPorLicencia(estadoFresco);
  }

  window.actualizarModuloRecepcionPorLicencia = function(esPro) {
    try {
      recepLicenciaPro = (esPro === true || esPro === "true");
      const badge = document.getElementById('recep-badge-modo-pro');
      const infoIcon = document.getElementById('recep-info-modo-estandar');
      const btnFirma = document.getElementById('recep-btn-firma-pro');
      const btnFirmaSalida = document.getElementById('recep-salida-btn-firma-pro');

      if (recepLicenciaPro) {
        if (badge) {
          badge.innerHTML = '<i class="fa-solid fa-star"></i> MODULO PRO ACTIVO';
          badge.style.background = "#deff9a";
          badge.style.color = "#000000";
          badge.style.borderColor = "#b4e63b";
        }
        if (infoIcon) infoIcon.style.display = 'none';
        [btnFirma, btnFirmaSalida].forEach(btn => {
          if (!btn) return;
          btn.style.background = "#deff9a";
          btn.style.color = "#000000";
          btn.style.borderColor = "#b4e63b";
          btn.style.cursor = "pointer";
          btn.title = "Capturar firma";
        });
      } else {
        if (badge) {
          badge.innerHTML = 'MODULO ESTANDAR';
          badge.style.background = "#f1f5f9";
          badge.style.color = "#64748b";
          badge.style.borderColor = "#cbd5e1";
        }
        if (infoIcon) infoIcon.style.display = 'inline-block';
        [btnFirma, btnFirmaSalida].forEach(btn => {
          if (!btn) return;
          btn.style.background = "#f1f5f9";
          btn.style.color = "#94a3b8";
          btn.style.borderColor = "#e2e8f0";
          btn.style.cursor = "not-allowed";
          btn.title = "Disponible en la versión PRO móvil";
        });
      }
    } catch (e) {
      console.error("Error en actualizacion de licencia (Recepcion):", e.message);
    }
  };

