  window.recep_CargarDatos = function() {
    if (typeof google === 'undefined' || !google.script || !google.script.run) return;
    google.script.run
      .withSuccessHandler(function(ords) { ORDENES_RECEPCION = ords || []; renderizarListaOrdenes(); })
      .obtenerOrdenesCompraServidor();

    google.script.run
      .withSuccessHandler(function(catalogo) {
        TODAS_LAS_VARIANTES_RECEP = [];
        (catalogo || []).forEach(p => (p.variantes || []).forEach(v => {
          TODAS_LAS_VARIANTES_RECEP.push({ sku: v.sku, descripcion: p.nombre + ' - ' + (v.etiqueta || 'Estandar') });
        }));
        poblarSelectorVariantesSalida();
      })
      .obtenerCatalogoParaRequisicionesServidor();

    google.script.run
      .withSuccessHandler(function(bodegas) { BODEGAS_GLOBAL_RECEP = bodegas || []; poblarSelectorBodegasSalida(); })
      .obtenerBodegasServidor();
  };

  window.recep_Filtrar = function() {
    renderizarListaOrdenes();
  };

  function renderizarListaOrdenes() {
    const cont = document.getElementById('recep-lista-ordenes');
    if (!cont) return;
    cont.innerHTML = '';

    const filtroTipo = document.getElementById('recep-filtro-tipo').value;
    const filtroTexto = (document.getElementById('recep-filtro-texto').value || '').toLowerCase().trim();

    const ordenesPendientes = ORDENES_RECEPCION.filter(o => {
      if (o.estado !== 'Pendiente de Recepción' && o.estado !== 'Recibida Parcial') return false;
      const tipoDestino = o.tipoDestino || 'Bodega';
      if (filtroTipo && tipoDestino !== filtroTipo) return false;
      if (filtroTexto) {
        const texto = (o.id + ' ' + o.proveedor + ' ' + (o.items || []).map(it => it.descripcion).join(' ')).toLowerCase();
        if (!texto.includes(filtroTexto)) return false;
      }
      return true;
    });

    if (ordenesPendientes.length === 0) {
      cont.innerHTML = '<div style="text-align:center; padding:30px; color:#94a3b8;">No hay órdenes pendientes de recepción.</div>';
      return;
    }

    ordenesPendientes.forEach(o => {
      const tipoDestino = o.tipoDestino || 'Bodega';
      const esEntregaDirecta = tipoDestino === 'Entrega Directa';
      const pendientes = (o.items || []).filter(it => (it.cantidadRecibida || 0) < (it.cantidadOrdenada || 0));

      const badgeDestino = esEntregaDirecta
        ? '<span style="background:#eff6ff; color:#1e40af; font-size:10px; font-weight:700; padding:2px 8px; border-radius:10px;"><i class="fa-solid fa-hand-holding"></i> ENTREGA DIRECTA</span>'
        : '<span style="background:#f0fdf4; color:#16a34a; font-size:10px; font-weight:700; padding:2px 8px; border-radius:10px;"><i class="fa-solid fa-warehouse"></i> ' + (o.bodegaDestino || 'Bodega') + '</span>';

      const subtitulo = esEntregaDirecta
        ? ('Para: ' + (o.entregaDirectaA || '—'))
        : ('Bodega: ' + (o.bodegaDestino || '—'));

      const tarjeta = document.createElement('div');
      tarjeta.style.cssText = "border:1px solid #e2e8f0; border-radius:8px; background:white; padding:14px 18px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;";
      tarjeta.innerHTML =
        '<div>' +
          '<div style="font-weight:700; color:#0f172a; font-size:13px; display:flex; align-items:center; gap:8px; flex-wrap:wrap;">' + o.id + ' — ' + o.proveedor + badgeDestino + '</div>' +
          '<div style="font-size:11px; color:#94a3b8; margin-top:2px;">' + subtitulo + ' · ' + pendientes.length + ' ítem(s) pendiente(s) de recibir</div>' +
        '</div>' +
        '<button type="button" style="height:36px; padding:0 14px; background:#16a34a; color:white; border:none; border-radius:6px; font-size:12px; font-weight:600; cursor:pointer;">Registrar Recepción</button>';
      tarjeta.querySelector('button').addEventListener('click', () => window.recep_AbrirModal(o.id));
      cont.appendChild(tarjeta);
    });
  }

  window.recep_AbrirModal = function(idOrden) {
    const orden = ORDENES_RECEPCION.find(o => o.id === idOrden);
    if (!orden) return;

    const tipoDestino = orden.tipoDestino || 'Bodega';
    const esEntregaDirecta = tipoDestino === 'Entrega Directa';

    document.getElementById('recep-id-orden').value = idOrden;
    document.getElementById('recep-tipo-destino-actual').value = tipoDestino;
    document.getElementById('recep-orden-ref').innerText = idOrden + ' — ' + orden.proveedor;

    const header = document.getElementById('recep-modal-header');
    const icono = document.getElementById('recep-modal-icono');
    const titulo = document.getElementById('recep-modal-titulo');
    const bloqueBodega = document.getElementById('recep-bloque-bodega');
    const bloqueEntrega = document.getElementById('recep-bloque-entrega-directa');

    firmaDigitalCapturada = false;
    document.getElementById('recep-recibido-por').value = '';
    document.getElementById('recep-firma-confirmada-texto').style.display = 'none';

    if (esEntregaDirecta) {
      header.style.background = '#1e40af';
      icono.className = 'fa-solid fa-hand-holding';
      titulo.innerText = 'Confirmar Entrega Directa';
      bloqueBodega.style.display = 'none';
      bloqueEntrega.style.display = 'flex';
      document.getElementById('recep-entrega-directa-texto').innerText = orden.entregaDirectaA || '—';
    } else {
      header.style.background = '#16a34a';
      icono.className = 'fa-solid fa-warehouse';
      titulo.innerText = 'Recepción en Bodega';
      bloqueBodega.style.display = 'flex';
      bloqueEntrega.style.display = 'none';
      // La bodega viene FIJA desde la orden -- el receptor solo confirma
      // cantidades, no puede elegir ni cambiar la bodega de destino.
      document.getElementById('recep-bodega-fija-texto').innerText = orden.bodegaDestino || 'Sin bodega definida';
    }

    const cont = document.getElementById('recep-items-pendientes');
    cont.innerHTML = '';

    (orden.items || []).forEach(it => {
      const pendiente = (it.cantidadOrdenada || 0) - (it.cantidadRecibida || 0);
      if (pendiente <= 0) return;

      const fila = document.createElement('div');
      fila.style.cssText = "background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:10px 12px; display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap;";
      fila.innerHTML =
        '<div style="flex:1; min-width:160px;"><span style="font-size:12px; font-weight:600; color:#1e293b;">' + it.descripcion + '</span><br>' +
        '<span style="font-size:10px; color:#94a3b8;">Pendiente: ' + pendiente + ' de ' + it.cantidadOrdenada + ' · Costo: $' + parseFloat(it.costoUnitario || 0).toFixed(2) + '</span></div>' +
        '<input type="number" class="recep-input-cantidad" data-sku="' + it.sku + '" data-pendiente="' + pendiente + '" min="0" max="' + pendiente + '" placeholder="0" style="width:80px; height:36px; border:1px solid #cbd5e1; border-radius:6px; padding:0 8px; box-sizing:border-box;">';
      cont.appendChild(fila);
    });

    document.getElementById('recep-modal').showModal();
  };

  window.recep_Guardar = function() {
    const idOrden = document.getElementById('recep-id-orden').value;
    const tipoDestino = document.getElementById('recep-tipo-destino-actual').value;
    const esEntregaDirecta = tipoDestino === 'Entrega Directa';
    const recibidoPor = document.getElementById('recep-recibido-por').value.trim();
    const inputs = document.querySelectorAll('.recep-input-cantidad');

    if (esEntregaDirecta && !recibidoPor) {
      window.erpToast("Indica el nombre de quién recibe la entrega.", "error");
      return;
    }

    const items = [];
    let huboError = false;
    inputs.forEach(input => {
      const cantidad = parseFloat(input.value) || 0;
      const pendiente = parseFloat(input.dataset.pendiente) || 0;
      if (cantidad > pendiente) huboError = true;
      if (cantidad > 0) items.push({ sku: input.dataset.sku, cantidadRecibida: cantidad });
    });

    if (huboError) { window.erpToast("No puedes recibir más de lo pendiente en algún ítem.", "error"); return; }
    if (items.length === 0) { window.erpToast("Indica al menos una cantidad recibida.", "error"); return; }

    if (typeof google !== 'undefined' && google.script && google.script.run) {
      google.script.run
        .withSuccessHandler(function(res) {
          window.erpToast(res.mensaje, res.exito ? 'exito' : 'error');
          if (res.exito) { document.getElementById('recep-modal').close(); window.recep_CargarDatos(); }
        })
        .withFailureHandler(function(err) { window.erpToast("Error: " + err.message, "error"); })
        .registrarRecepcionCompraServidor({
          idOrden: idOrden,
          items: items,
          recibidoPor: recibidoPor,
          firmaDigital: firmaDigitalCapturada ? 'CONFIRMADA' : ''
        });
    }
  };

